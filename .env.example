# Copy this file to .env.local. Never commit your real secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
CLERK_JWT_ISSUER_DOMAIN=

# Configure the same random 32+ byte secret in Convex and n8n.
# Convex: npx convex env set LENDLOOP_N8N_SECRET "<random-secret>"
LENDLOOP_N8N_SECRET=

# Convex action sends signed request/status events to the n8n production webhook URL.
N8N_REQUEST_WEBHOOK_URL=
